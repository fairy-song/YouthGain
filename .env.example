# ============================================
# 青盈 YouthGain 环境变量配置
# 复制本文件为 .env.local 后填写实际值
# ============================================

# ---------- AI 服务 ----------
# 智谱AI API密钥（必需，AI 教练功能依赖）
# 获取地址: https://open.bigmodel.cn/
ZHIPUAI_API_KEY=

# Google Gemini API密钥（可选，不使用 Gemini 时留空）
GEMINI_API_KEY=

# ---------- 安全 ----------
# Flask 会话密钥，生产环境务必替换为随机值
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ---------- 开发模式 ----------
# 设为 true 时跳过身份校验，直接使用模拟用户 test_user_id。
#
# ⚠️ 仅限本地开发。开启后所有人都能读写 test_user_id 名下的数据。
# ⚠️ 部署到任何公开环境前必须删除或设为 false。
# 当 APP_ENV 或 FLASK_ENV 为 production 时，本开关会自动失效。
DEV_MODE=false

# 运行环境标识：development / production
APP_ENV=development

# ---------- 数据库 ----------
# 存储类型: memory（内存，重启即丢）/ mysql / firestore
DB_TYPE=memory

# MySQL 配置（DB_TYPE=mysql 时生效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=youthgain

# ---------- 学校研究（默认仅模拟演示） ----------
# 完成真实研究配置和验收后启用；学生仍需逐项目主动参与。
RESEARCH_LIVE_ENABLED=false
# 所有后端进程必须指向同一个本机持久化路径；生产环境必填。
RESEARCH_DB_PATH=
# 初次创建研究账本时的全平台累计 epsilon 上限，单位为千分之一。
# 账本建立后更改此值不会重置或增加预算；不得删除账本重置预算。
RESEARCH_GLOBAL_EPSILON_MILLI=6000

# ---------- 每日音频博客 ----------
# 推荐、快照、储蓄目标及内部资金账目共用此 SQLite；所有后端进程共用同一路径，生产环境必填。
PODCAST_DB_PATH=
# 新数据库自动加入首批按公开页面核对的节目；设为 false 可关闭。
PODCAST_STARTER_CATALOG_ENABLED=true
# 仅允许同步这里列出的已核准 RSS 主机，多个用英文逗号分隔。
PODCAST_RSS_ALLOWED_HOSTS=
# local_hstu：项目内 HSTU 推理；local_shadow：仅对比得分；baseline：规则回退。
# hstu/shadow 保留外部 HSTU 服务协议。权重未就绪时自动采用规则回退并报告原因。
PODCAST_RANKER_MODE=local_hstu
PODCAST_HSTU_MODEL_PATH=models/hstu/model.pt
# 只供本地合成数据演示；production 环境即使此项为 true 也拒绝演示权重。
PODCAST_HSTU_ALLOW_DEMO=false
# 外部 HSTU 推理端点；v2 协议与资金口径见 docs/财务推荐v2模块定义.md。
PODCAST_HSTU_URL=
PODCAST_HSTU_API_KEY=
PODCAST_HSTU_TIMEOUT_SECONDS=2

# ---------- AI 教练混合检索 ----------
# 先运行 backend/prepare_coach_models.py；请求期间不会下载模型。
COACH_RETRIEVAL_MODE=hybrid
COACH_EMBEDDING_PATH=models/coach/embedding
COACH_RERANKER_PATH=models/coach/reranker
COACH_SEMANTIC_MIN_SCORE=0.45
COACH_RERANK_MIN_LOGIT=-5

# ---------- Firebase（生产环境认证必需）----------
# Firebase Admin SDK 服务账号密钥文件路径
FIREBASE_ADMIN_SDK_PATH=

# ---------- 跨域 ----------
# 额外的允许来源，多个用英文逗号分隔
CORS_ALLOWED_ORIGINS=

# ---------- 管理员 ----------
# 管理员邮箱列表（逗号分隔）。命中该邮箱的账号登录后拥有管理员角色，
# 可访问 /api/admin/* 接口与管理后台页面。开发模式同样按该列表判定角色。
ADMIN_EMAILS=admin@youthgain.com
